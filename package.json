{
  "name": "ieum",
  "private": true,
  "version": "1.2.0",
  "packageManager": "pnpm@12.16.1",
  "engines": { "node": ">=24" },
  "scripts": {
    "dev": "pnpm --parallel --filter @ieum/api --filter @ieum/web dev",
