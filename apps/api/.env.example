# 운영에서는 모두 필수입니다.
NODE_ENV=production
PORT=4000
# 비워 두면 로컬 PGlite(.data/db)를 씁니다. 운영은 PostgreSQL 주소를 넣습니다.
DATABASE_URL=postgres://ieum:CHANGE_ME@localhost:5432/ieum
# 32자 이상의 임의 문자열
JWT_SECRET=CHANGE_ME
# 웹뷰가 올라간 주소. 쉼표로 여러 개
CORS_ORIGINS=https://app.example.com
# 업로드 이미지를 제공하는 공개 주소
PUBLIC_BASE_URL=https://api.example.com
# 이미지 저장소. S3_BUCKET이 없으면 UPLOAD_DIR(서버 디스크)을 씁니다.
UPLOAD_DIR=/var/lib/ieum/uploads
S3_BUCKET=
S3_REGION=ap-northeast-2
# AWS가 아닌 S3 호환 저장소의 주소 (R2, 네이버 클라우드 등)
S3_ENDPOINT=
# 이미지 공개 주소 (CDN)
S3_PUBLIC_URL=https://media.example.com
# 인증은 AWS SDK 방식입니다. IAM 역할 또는 아래 값
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 메일 (운영 필수). 예: smtps://user:pass@smtp.example.com:465
SMTP_URL=
MAIL_FROM=이음 <no-reply@example.com>
# 새 신고를 알릴 운영자 메일
REPORT_ALERT_EMAIL=
# 소셜 로그인 후 돌아갈 웹 주소
APP_WEB_URL=https://app.example.com
# 소셜 로그인. 값이 없는 제공자의 버튼은 표시되지 않습니다. 비밀 값은 서버에만 둡니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Apple: Services ID, 팀 ID, 키 ID, .p8 내용(줄바꿈은 \n), 재발급 토큰 암호화 키(32자 이상)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SOCIAL_TOKEN_KEY=
