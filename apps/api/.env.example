# 운영에서는 모두 필수입니다.
NODE_ENV=production
PORT=4000
# 비워 두면 로컬 PGlite(.data/db)를 씁니다. 운영은 PostgreSQL 주소를 넣습니다.
DATABASE_URL=postgres://ieum:CHANGE_ME@localhost:5432/ieum
# 32자 이상의 임의 문자열
JWT_SECRET=CHANGE_ME
# 웹뷰가 올라간 주소. 쉼표로 여러 개
CORS_ORIGINS=https://app.example.com
# 업로드 이미지를 제공하는 공개 주소
PUBLIC_BASE_URL=https://api.example.com
UPLOAD_DIR=/var/lib/ieum/uploads
# 소셜 로그인 후 돌아갈 웹 주소
APP_WEB_URL=https://app.example.com
# 소셜 로그인. 값이 없는 제공자의 버튼은 표시되지 않습니다. 비밀 값은 서버에만 둡니다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
