{
  "name": "@ieum/web",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fsd": "steiger src",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:e2e": "playwright test --config playwright.config.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --quiet",
    "icons": "node scripts/render-app-icons.ts",
    "dev:demo": "VITE_DEMO_MODE=true vite",
    "build:demo": "VITE_DEMO_MODE=true tsc --noEmit && VITE_DEMO_MODE=true vite build",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@tanstack/react-query": "^5.105.3",
    "@vanilla-extract/css": "^1.21.3",
    "antd": "^6.7.0",
    "pretendard": "1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@feature-sliced/steiger-plugin": "^0.8.2",
    "@playwright/test": "^1.64.1",
    "@storybook/addon-a11y": "^10.6.5",
    "@storybook/addon-vitest": "^10.6.5",
    "@storybook/react-vite": "^10.6.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.3",
    "msw": "^3.0.3",
    "steiger": "^0.9.0",
    "storybook": "^10.6.5",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}